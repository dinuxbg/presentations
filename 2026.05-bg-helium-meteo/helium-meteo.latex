\begin{frame}[fragile]
  \frametitle{История на firmware-a}
  \begin{itemize}
    \item \sout{Копиран от} Базиран на друг проект със Zephyr и LoRaWan.
    \begin{itemize}
      \item \url{https://github.com/retfie/helium_mapper}
      \item Устройство за картографиране покритието на Helium мрежата.
      \item Праща GPS координати посредством Helium LoRaWan.
      \item Записва кои Helium hotspots са "чули" отчетите за дадени координати.
    \end{itemize}
  \item Махнах GPS, интегрирах BME280 драйвера на Zephyr.
  \end{itemize}
\end{frame}

