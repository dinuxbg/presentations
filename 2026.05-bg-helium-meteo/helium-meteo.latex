\begin{frame}[fragile]
  \frametitle{Какво е Helium Meteo?}
  \begin{itemize}
    \item Устройство за отчитане на температура, влажност и атм. налягане (BME280).
    \item Изпраща отчети посредством радио.
    \item Една батерия е достатъчна за работа няколко години.
    \pause
    \item Дотук прилича на "купешка" метео станция от железарията.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]
  \frametitle{Buzzwords!}
  \begin{itemize}
    \item Open source
    \item Zephyr
    \item LoRaWAN
    \item Private cloud
    \item Cryptocurrency, blockchain
    \item Made in EU
  \end{itemize}
\end{frame}

\begin{frame}[fragile]
  \frametitle{Как изглежда?}
  \includegraphics[width=0.8\textwidth,height=0.8\textheight,keepaspectratio=true]{helium-meteo-breadboard.png}
\end{frame}

\begin{frame}[fragile]
  \frametitle{Какво е Helium Meteo?}
  \begin{itemize}
    \item LoRaWan радио (STM32WL).
    \begin{itemize}
      \item Километри обхват при пряка видимост.
    \end{itemize}
    \item Хелиева мрежа за интернет на нещата.
    \begin{itemize}
      \item Helium IOT
      \item \url{https://www.helium.com/iot}
    \end{itemize}
  \end{itemize}
\end{frame}

\begin{frame}[fragile]
  \frametitle{Защо Helium Meteo?}
  \begin{itemize}
    \item Отчетите се записват в СУБД на собствен облак.
    \item ~1000 SLOC C App на Zephyr OS.
    \begin{itemize}
      \item Най-добрата RTOS (според мен)!
    \end{itemize}
    \item Обща консумация под 10\mu A.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]
  \frametitle{Защо Helium Meteo?}
  \begin{itemize}
    \item Отворен код.
    \begin{itemize}
      \item \url{https://github.com/dinuxbg/helium_meteo}
    \end{itemize}
    \item Цена - 50 изпратени отчета за 1 стотинка.
    \item Цена - BOM е <20 EUR.
      \begin{itemize}
        \item Olimex BB-STM32WL-ANT.
        \item Olimex MOD-BME280.
      \end{itemize}
    \item Добро покритие на Helium IOT.
    \begin{itemize}
      \item Десетки километри при пряка видимост с Hotspot.
    \end{itemize}
  \end{itemize}
\end{frame}

\begin{frame}[fragile]
  \frametitle{Helium IOT}
  \begin{itemize}
    \item Радио покритие се осигурява от Helium Hotspots
    \item Всеки може да закупи, постави и свърже Helium Hotspots.
    \begin{itemize}
      \item Облагата е, че се печели crypto валута.
    \end{itemize}
    \item Алтернативи на Helium IOT
    \begin{itemize}
      \item ChirpStack, open-source LoRaWAN® Network Server 
      \item The Things Network
    \end{itemize}
  \end{itemize}
\end{frame}

