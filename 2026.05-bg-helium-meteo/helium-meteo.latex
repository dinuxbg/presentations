\begin{frame}[fragile]
  \frametitle{Собствен облак}
  \begin{itemize}
    \item Helium IOT е само за пренос на данни.
    \item HTTP integration server: ~200 SLOC Python.
    \item SQLite DB.
  \end{itemize}
\end{frame}

\begin{frame}[fragile]
  \frametitle{Пример}
\begin{lstlisting}
$ cat queries/dump-data.sql | \
  sqlite3 meteo.db | tail -2

| Device name | °C  |  Pa   | %
|-------------|-----|-------|----
Helium Meteo 2|21.26|94000.0|48.0
Helium Meteo 1|21.73|94000.0|43.0
\end{lstlisting}
\end{frame}

